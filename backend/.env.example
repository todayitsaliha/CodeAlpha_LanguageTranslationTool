# Copy to .env (never commit .env)

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Provider selection: google | microsoft | gemini
TRANSLATION_PROVIDER=google

# Google Cloud Translation (required when TRANSLATION_PROVIDER=google)
GOOGLE_TRANSLATE_API_KEY=

# Microsoft Translator (required key when TRANSLATION_PROVIDER=microsoft;
# region is only needed for regional / multi-service resources)
MICROSOFT_TRANSLATOR_KEY=
MICROSOFT_TRANSLATOR_REGION=

# Google Gemini (required when TRANSLATION_PROVIDER=gemini). Create a key at
# https://aistudio.google.com/apikey. Model names change often: confirm the model is
# current and on your plan in AI Studio. Note: free-tier requests may be used by Google
# to improve its products, so do not use the free tier for confidential text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Request limits
MAX_TEXT_LENGTH=5000
# Provider timeout in ms. Leave unset for the defaults: 8000, or 20000 for gemini
# (an AI model generates its answer, which takes longer).
# PROVIDER_TIMEOUT_MS=8000

# Rate limiting for POST /api/translate (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops in front of the API (0 = none).
# Set to 1 behind a single load balancer so rate limiting sees real client IPs.
TRUST_PROXY=0

# How long the supported-language list is cached (default 24h)
LANGUAGES_CACHE_TTL_MS=86400000
