# Copy to .env.local (never commit it). All values are optional.

# Leave empty in development: Vite proxies /api to the backend (see vite.config.mjs).
# In production set this to the deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Must match MAX_TEXT_LENGTH in backend/.env
VITE_MAX_TEXT_LENGTH=5000

# Target language preselected on first load (used if the provider supports it)
VITE_DEFAULT_TARGET_LANGUAGE=es
